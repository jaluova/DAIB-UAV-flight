ALGORITHM_IMAGE=daib-algorithm:openeuler-arm64
DRIVERS_IMAGE=daib-drivers:openeuler-arm64

# Keep this at 1 on the 8 GiB Orange Pi and on memory-constrained build hosts.
BUILD_JOBS=1
REALSENSE_FORCE_RSUSB_BACKEND=ON

# Orange Pi NVMe directory mounted into both containers as /data.
DATA_DIR=/mnt/ssd/data
BAGS_DIR=/mnt/ssd/bags

# Portable for ARMv8-A boards. Tune only after validating the target CPU.
FAST_LIVO_ARM_FLAGS=-march=armv8-a
VIKIT_REF=master
FOXGLOVE_BRIDGE_REF=0.8.5
ROS_BABEL_FISH_REF=0.9.3
WEBSOCKETPP_REF=0.8.2

# Validated with the MID-70 connected to the dedicated wired interface.
CONFIGURE_LIDAR_INTERFACE=true
CONFIGURE_LIDAR_RP_FILTER=true
VERIFY_LIDAR_RP_FILTER=true
LIDAR_INTERFACE=enP3p49s0
LIDAR_HOST_CIDR=192.168.1.50/24
LIDAR_DEVICE_IP=192.168.1.119

ENABLE_REALSENSE=true
ENABLE_LIVOX=true
REALSENSE_ARGS=enable_depth:=true enable_color:=true enable_gyro:=true enable_accel:=true unite_imu_method:=linear_interpolation
LIVOX_ARGS=bd_list:=3GGDLA4001V3191 publish_freq:=10.0

# Safe default: LIO only, no RViz. Enable the camera after checking calibration.
ALGORITHM_LAUNCH=fast_livo mapping_mid70_d435i.launch rviz:=false use_camera:=false

# Foxglove WebSocket is available at ws://<orange-pi-ip>:8765. In the 3D
# panel, use camera_init as the fixed frame.
ENABLE_FOXGLOVE=true
FOXGLOVE_PORT=8765

# Leave BAG_FILE empty for live sensors. For an offline test, set a path below
# the read-only /bags mount and start only the algorithm service.
BAG_FILE=
BAG_ALGORITHM_LAUNCH=fast_livo mapping_mid70_d435i.launch rviz:=false use_camera:=true
BAG_RATE=1.0
BAG_DELAY=2.0
BAG_LOOP=false
